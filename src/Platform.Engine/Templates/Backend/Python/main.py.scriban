import uvicorn
from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
from app.database import init_db
{{ for entity in Entities }}
from app.routers.{{ entity.Name.toLowerCase() }} import router as {{ entity.Name.toLowerCase() }}_router
{{ end }}

app = FastAPI(
    title="{{ ProjectName }} API",
    description="Auto-generated API backend by DynamicPlatform",
    version="1.0.0"
)

# CORS configuration
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

@app.on_event("startup")
async def on_startup():
    await init_db()

{{ for entity in Entities }}
app.include_router({{ entity.Name.toLowerCase() }}_router, prefix="/api/{{ entity.Name.toLowerCase() }}s", tags=["{{ entity.Name }}"])
{{ end }}

if __name__ == "__main__":
    uvicorn.run("main:app", host="0.0.0.0", port=5018, reload=True)
