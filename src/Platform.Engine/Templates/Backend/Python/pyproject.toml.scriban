[tool.poetry]
name = "{{ ProjectName }}"
version = "1.0.0"
description = "Auto-generated FastAPI backend by DynamicPlatform"
authors = ["DynamicPlatform Agent"]

[tool.poetry.dependencies]
python = "^3.10"
fastapi = "^0.110.0"
uvicorn = {extras = ["standard"], version = "^0.29.0"}
sqlmodel = "^0.0.16"
asyncpg = "^0.29.0"
aiosqlite = "^0.20.0"
pydantic-settings = "^2.2.1"
cryptography = "^42.0.5"

[build-system]
requires = ["poetry-core>=1.0.0"]
build-backend = "poetry.core.masonry.api"
