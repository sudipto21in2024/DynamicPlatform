import uuid
from typing import List, Optional
from fastapi import APIRouter, Depends, HTTPException, status
from sqlmodel import select
from sqlmodel.ext.asyncio.session import AsyncSession
from app.database import get_session
from app.models import {{ Name }}

router = APIRouter()

@router.get("/", response_model=List[{{ Name }}])
async def get_all(
    pageIndex: Optional[int] = None,
    pageSize: Optional[int] = None,
    session: AsyncSession = Depends(get_session)
):
    if pageIndex is not None and pageSize is not None:
        statement = select({{ Name }}).offset(pageIndex * pageSize).limit(pageSize)
        result = await session.execute(statement)
        items = result.scalars().all()
        # Find total count
        count_statement = select({{ Name }})
        count_result = await session.execute(count_statement)
        total_count = len(count_result.scalars().all())
        # Return format matching C# Ok(new { items, totalCount })
        # Note: FastAPI expects dict when we return custom structured object matching paged response
        return {"items": items, "totalCount": total_count}
        
    statement = select({{ Name }})
    result = await session.execute(statement)
    return result.scalars().all()

@router.get("/{id}", response_model={{ Name }})
async def get_by_id(id: uuid.UUID, session: AsyncSession = Depends(get_session)):
    db_item = await session.get({{ Name }}, id)
    if not db_item:
        raise HTTPException(status_code=404, detail="Item not found")
    return db_item

@router.post("/", response_model={{ Name }}, status_code=status.HTTP_201_CREATED)
async def create(item: {{ Name }}, session: AsyncSession = Depends(get_session)):
    session.add(item)
    await session.commit()
    await session.refresh(item)
    return item

@router.put("/{id}", response_model={{ Name }})
async def update(id: uuid.UUID, item: {{ Name }}, session: AsyncSession = Depends(get_session)):
    db_item = await session.get({{ Name }}, id)
    if not db_item:
        raise HTTPException(status_code=404, detail="Item not found")
    
    item_data = item.dict(exclude_unset=True)
    for key, value in item_data.items():
        if key != "id":
            setattr(db_item, key, value)
            
    session.add(db_item)
    await session.commit()
    await session.refresh(db_item)
    return db_item

@router.delete("/{id}", status_code=status.HTTP_204_NO_CONTENT)
async def delete(id: uuid.UUID, session: AsyncSession = Depends(get_session)):
    db_item = await session.get({{ Name }}, id)
    if not db_item:
        raise HTTPException(status_code=404, detail="Item not found")
    await session.delete(db_item)
    await session.commit()
    return None
