import { Entity, Column, PrimaryGeneratedColumn, ManyToOne, OneToMany, JoinColumn, Index, Unique } from 'typeorm';
import { IsNotEmpty, IsOptional, MaxLength, MinLength, IsEmail, Matches, IsUrl, IsCreditCard, Min, Max } from 'class-validator';

@Entity('{{ Name.toLowerCase() }}s')
export class {{ Name }} {
  @PrimaryGeneratedColumn('uuid')
  id: string;

  {{ for field in Fields }}
  {{ if field.IsRequired }}@IsNotEmpty({ message: '{{ field.ValidationMessage | object.default (field.DisplayLabel + " is required") }}' }){{ else }}@IsOptional(){{ end }}
  {{ if field.MaxLength > 0 }}@MaxLength({{ field.MaxLength }}, { message: '{{ field.DisplayLabel }} exceeds max length of {{ field.MaxLength }}' }){{ end }}
  {{ if field.MinLength > 0 }}@MinLength({{ field.MinLength }}, { message: '{{ field.DisplayLabel }} must be at least {{ field.MinLength }} characters' }){{ end }}
  {{ for rule in field.Rules }}
  {{ if rule.Type == "Regex" }}@Matches(new RegExp('{{ rule.Value }}'), { message: '{{ rule.ErrorMessage }}' }){{ end }}
  {{ if rule.Type == "Email" }}@IsEmail({}, { message: '{{ rule.ErrorMessage }}' }){{ end }}
  {{ if rule.Type == "URL" }}@IsUrl({}, { message: '{{ rule.ErrorMessage }}' }){{ end }}
  {{ if rule.Type == "CreditCard" }}@IsCreditCard({ message: '{{ rule.ErrorMessage }}' }){{ end }}
  {{ if rule.Type == "MinValue" }}@Min({{ rule.Value }}, { message: '{{ rule.ErrorMessage }}' }){{ end }}
  {{ if rule.Type == "MaxValue" }}@Max({{ rule.Value }}, { message: '{{ rule.ErrorMessage }}' }){{ end }}
  {{ end }}
  {{ if field.IsIndexed }}@Index(){{ end }}
  @Column({ name: '{{ field.ColumnName | object.default field.Name.toLowerCase() }}', nullable: {{ !field.IsRequired }}{{ if field.IsUnique }}, unique: true{{ end }}{{ if field.DefaultValue != "" }}, default: '{{ field.DefaultValue }}'{{ end }} })
  {{ field.Name.substring 0 1 | string.downcase }}{{ field.Name.substring 1 }}: {{ field.TsType }};

  {{ end }}

  {{ for rel in Relations }}
  {{ if rel.Type == 1 || rel.Type == "ManyToOne" }}
  @ManyToOne(() => {{ rel.TargetEntity }}, { onDelete: 'SET NULL' })
  @JoinColumn({ name: '{{ rel.ForeignKeyName.toLowerCase() | object.default (rel.TargetEntity.toLowerCase() + "_id") }}' })
  {{ rel.NavPropName.toLowerCase() }}: {{ rel.TargetEntity }};
  {{ else if rel.Type == 0 || rel.Type == "OneToMany" || rel.Type == 2 || rel.Type == "ManyToMany" }}
  @OneToMany(() => {{ rel.TargetEntity }}, (target) => target.{{ Name.toLowerCase() }})
  {{ rel.NavPropName.toLowerCase() }}: {{ rel.TargetEntity }}[];
  {{ end }}
  {{ end }}
}
