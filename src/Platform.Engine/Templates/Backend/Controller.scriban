using System;
using System.Collections.Generic;
using System.Threading.Tasks;
using Microsoft.AspNetCore.Mvc;
using Platform.Runtime.Persistence;
using GeneratedApp.Repositories;
using {{ Namespace }};

namespace GeneratedApp.Controllers;

/// <summary>
/// API Controller for managing {{ Name }} resources.
/// </summary>
[ApiController]
[Route("api/[controller]")]
public class {{ Name }}Controller : ControllerBase
{
    private readonly IRepository<{{ Name }}> _repository;

    public {{ Name }}Controller(IRepository<{{ Name }}> repository)
    {
        _repository = repository;
    }

    /// <summary>
    /// Retrieves a list of all {{ Name }} resources, optionally paged.
    /// </summary>
    /// <param name="pageIndex">The zero-based page index.</param>
    /// <param name="pageSize">The size of the page.</param>
    /// <returns>A list of {{ Name }} resources.</returns>
    [HttpGet(Name = "Get{{ Name }}List")]
    public async Task<ActionResult> Get([FromQuery] int? pageIndex, [FromQuery] int? pageSize)
    {
        if (pageIndex.HasValue && pageSize.HasValue)
        {
            var result = await _repository.GetPagedAsync(pageIndex.Value, pageSize.Value);
            return Ok(new { items = result.Items, totalCount = result.TotalCount });
        }
        
        var items = await _repository.GetAllAsync();
        return Ok(items);
    }

    /// <summary>
    /// Retrieves a specific {{ Name }} by its unique identifier.
    /// </summary>
    /// <param name="id">The unique identifier of the {{ Name }}.</param>
    /// <returns>The requested {{ Name }} resource.</returns>
    [HttpGet("{id}", Name = "Get{{ Name }}ById")]
    public async Task<ActionResult<{{ Name }}>> GetById(Guid id)
    {
        var item = await _repository.GetByIdAsync(id);
        if (item == null) return NotFound();
        return Ok(item);
    }

    /// <summary>
    /// Creates a new {{ Name }} resource.
    /// </summary>
    /// <param name="item">The {{ Name }} resource to create.</param>
    /// <returns>The newly created {{ Name }} resource.</returns>
    [HttpPost(Name = "Create{{ Name }}")]
    public async Task<ActionResult<{{ Name }}>> Create({{ Name }} item)
    {
        await _repository.AddAsync(item);
        return CreatedAtAction(nameof(GetById), new { id = item.Id }, item);
    }

    /// <summary>
    /// Updates an existing {{ Name }} resource.
    /// </summary>
    /// <param name="id">The unique identifier of the {{ Name }} to update.</param>
    /// <param name="item">The updated {{ Name }} data.</param>
    /// <returns>No content on success.</returns>
    [HttpPut("{id}", Name = "Update{{ Name }}")]
    public async Task<IActionResult> Update(Guid id, {{ Name }} item)
    {
        if (id != item.Id) return BadRequest();
        await _repository.UpdateAsync(item);
        return NoContent();
    }

    /// <summary>
    /// Deletes a specific {{ Name }} resource.
    /// </summary>
    /// <param name="id">The unique identifier of the {{ Name }} to delete.</param>
    /// <returns>No content on success.</returns>
    [HttpDelete("{id}", Name = "Delete{{ Name }}")]
    public async Task<IActionResult> Delete(Guid id)
    {
        await _repository.DeleteAsync(id);
        return NoContent();
    }
}
