/* TailAdmin Premium Form CSS */
:host {
  display: block;
  width: 100%;
}

.premium-form-card {
  max-width: 56rem;
  margin: 0 auto;
  background-color: #24303F;
  border: 1px solid #2E3A47;
  border-radius: 1.5rem;
  padding: 2rem;
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

.accent-top-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: linear-gradient(90deg, #3C50E0 0%, #80CAEE 100%);
}

.card-header-panel {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 2rem;
}

.card-title {
  font-size: 1.5rem;
  font-weight: 900;
  color: #fff;
  margin: 0 0 0.25rem;
}

.accent-text {
  color: #3C50E0;
}

.card-subtitle {
  font-size: 0.875rem;
  color: #8A99AD;
  margin: 0;
}

.mono-code {
  background-color: #1A2238;
  padding: 0.125rem 0.5rem;
  border-radius: 4px;
  color: #80CAEE;
  font-family: monospace;
  font-size: 0.8125rem;
}

.header-mode-controls {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.mode-badge {
  padding: 0.25rem 0.75rem;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  border-radius: 9999px;
  border: 1px solid transparent;
}

.badge-create {
  background-color: rgba(16, 185, 129, 0.1);
  color: #10B981;
  border-color: rgba(16, 185, 129, 0.2);
}

.badge-edit {
  background-color: rgba(59, 130, 246, 0.1);
  color: #3B82F6;
  border-color: rgba(59, 130, 246, 0.2);
}

.badge-view {
  background-color: rgba(138, 153, 173, 0.1);
  color: #8A99AD;
  border-color: rgba(138, 153, 173, 0.2);
}

.btn-toggle-edit {
  background-color: #3C50E0;
  color: #fff;
  border: none;
  padding: 0.375rem 1rem;
  border-radius: 8px;
  font-size: 0.75rem;
  font-weight: 700;
  cursor: pointer;
  transition: background-color 0.2s;
}

.btn-toggle-edit:hover {
  background-color: #2D3EB7;
}

.btn-toggle-view {
  background-color: #1A2238;
  color: #AEB7C0;
  border: 1px solid #2E3A47;
  padding: 0.375rem 1rem;
  border-radius: 8px;
  font-size: 0.75rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s;
}

.btn-toggle-view:hover {
  background-color: rgba(255, 255, 255, 0.05);
  color: #fff;
}

.banner-error {
  margin-bottom: 1.5rem;
  padding: 1rem;
  background-color: rgba(239, 68, 68, 0.1);
  border: 1px solid rgba(239, 68, 68, 0.2);
  border-radius: 12px;
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
}

.banner-icon {
  font-size: 1.25rem;
}

.banner-title {
  font-weight: 700;
  color: #FCA5A5;
  margin: 0 0 0.125rem;
  font-size: 0.875rem;
}

.banner-desc {
  font-size: 0.75rem;
  color: #F87171;
  margin: 0;
}

/* View Mode Details */
.view-mode-panel, .form-mode-panel {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.section-group {
  background-color: rgba(0, 0, 0, 0.1);
  border: 1px solid #2E3A47;
  border-radius: 1rem;
  padding: 1.5rem;
}

.section-divider {
  font-size: 0.75rem;
  font-weight: 800;
  text-transform: uppercase;
  color: #3C50E0;
  letter-spacing: 0.1em;
  margin: 0 0 1.5rem;
  text-align: center;
}

.view-grid, .form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1.5rem;
}

.view-item {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  border-bottom: 1px solid rgba(46, 58, 71, 0.5);
  padding-bottom: 0.5rem;
}

.view-label {
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  color: #8A99AD;
}

.view-value-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.view-value {
  font-size: 0.875rem;
  font-weight: 600;
  color: #fff;
}

/* Form inputs styling */
.field-item {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.col-span-2 {
  grid-column: span 2 / span 2;
}

.col-span-1 {
  grid-column: span 1 / span 1;
}

.input-label {
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  color: #AEB7C0;
}

.input-field, .textarea-field {
  width: 100%;
  background-color: #1A2238;
  border: 1px solid #2E3A47;
  border-radius: 12px;
  padding: 0.75rem 1rem;
  color: #fff;
  outline: none;
  font-size: 0.875rem;
  transition: all 0.2s;
  box-sizing: border-box;
}

.input-field:focus, .textarea-field:focus {
  border-color: #3C50E0;
  box-shadow: 0 0 0 3px rgba(60, 80, 224, 0.15);
}

.textarea-field {
  resize: vertical;
}

.checkbox-wrapper {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-top: 0.5rem;
}

.checkbox-input {
  width: 1.25rem;
  height: 1.25rem;
  border-radius: 4px;
  background-color: #1A2238;
  border: 1px solid #2E3A47;
  accent-color: #3C50E0;
  cursor: pointer;
}

.checkbox-label {
  font-size: 0.875rem;
  color: #AEB7C0;
  font-weight: 500;
}

.field-error-msg {
  color: #F87171;
  font-size: 0.75rem;
  font-weight: 600;
  margin-top: 0.25rem;
  display: flex;
  align-items: center;
  gap: 0.25rem;
}

/* Actions Panel */
.actions-panel {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 1.5rem;
  border-top: 1px solid #2E3A47;
}

.btn-cancel {
  background-color: transparent;
  border: 1px solid #2E3A47;
  color: #AEB7C0;
  padding: 0.75rem 1.5rem;
  border-radius: 12px;
  font-size: 0.875rem;
  font-weight: 700;
  text-transform: uppercase;
  cursor: pointer;
  transition: all 0.2s;
}

.btn-cancel:hover {
  background-color: rgba(255, 255, 255, 0.05);
  color: #fff;
}

.btn-submit {
  background: linear-gradient(90deg, #3C50E0 0%, #2D3EB7 100%);
  color: #fff;
  border: none;
  padding: 0.75rem 2rem;
  border-radius: 12px;
  font-size: 0.875rem;
  font-weight: 700;
  text-transform: uppercase;
  cursor: pointer;
  transition: opacity 0.2s, transform 0.2s;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.btn-submit:hover:not(:disabled) {
  opacity: 0.95;
  transform: translateY(-1px);
}

.btn-submit:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.spinner-icon {
  animation: spin 1s linear infinite;
  font-size: 1rem;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
