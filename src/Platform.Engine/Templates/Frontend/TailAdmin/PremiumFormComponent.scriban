import { Component, OnInit, OnDestroy, Input, Output, EventEmitter, ChangeDetectionStrategy, signal, DestroyRef, inject } from '@angular/core';
import { CommonModule } from '@angular/common';
import { ReactiveFormsModule, FormBuilder, FormGroup, Validators } from '@angular/forms';
import { HttpClient } from '@angular/common/http';
import { takeUntilDestroyed } from '@angular/core/rxjs-interop';
import { Subject, Observable, of } from 'rxjs';
import { debounceTime, distinctUntilChanged, switchMap, catchError } from 'rxjs/operators';

@Component({
  selector: 'app-{{ name | string.downcase }}-premium-form',
  standalone: true,
  changeDetection: ChangeDetectionStrategy.OnPush,
  imports: [CommonModule, ReactiveFormsModule],
  template: `
    <!-- Premium TailAdmin Glassmorphic Container -->
    <div class="premium-form-card">
      <!-- Top Accent Line -->
      <div class="accent-top-bar"></div>

      <!-- Detail/View Mode Header -->
      <div class="card-header-panel">
        <div>
           <h2 class="card-title">{{ name }} <span class="accent-text">Builder</span></h2>
           <p class="card-subtitle">Active Domain target: <code class="mono-code">{{ entity_target }}</code></p>
        </div>
        <div class="header-mode-controls">
           <span class="mode-badge" 
                 [ngClass]="{
                   'badge-create': mode() === 'Create',
                   'badge-edit': mode() === 'Edit',
                   'badge-view': mode() === 'View'
                 }">
             {{ mode() }} Mode
           </span>
           <button *ngIf="mode() === 'View'" (click)="setMode('Edit')" class="btn-toggle-edit">
             Edit Record
           </button>
           <button *ngIf="mode() === 'Edit'" (click)="setMode('View')" class="btn-toggle-view">
             View Mode
           </button>
        </div>
      </div>

      <!-- State Banners -->
      <div *ngIf="error()" class="banner-error">
         <span class="banner-icon">⚠️</span>
         <div>
            <h4 class="banner-title">Fault State Detected</h4>
            <p class="banner-desc">{{ error() }}</p>
         </div>
      </div>

      <!-- Render Label-Value pairs if in View / Detail Mode -->
      <div *ngIf="mode() === 'View'" class="view-mode-panel">
        {{~ for section in sections ~}}
        <div class="section-group">
           <h3 class="section-divider">── {{ section.title }} ──</h3>
           <div class="view-grid">
             {{~ for field_name in section.field_names ~}}
             {{~ for f in fields ~}}
             {{~ if f.name == field_name ~}}
             <div class="view-item">
                 <span class="view-label">{{ f.label }}</span>
                 <div class="view-value-box">
                    <span class="view-value">
                       {{~ if f.type == 'bool' ~}}
                       {{ '{{' }} form.get('{{ f.name }}')?.value ? 'Yes' : 'No' {{ '}}' }}
                       {{~ else ~}}
                       {{ '{{' }} form.get('{{ f.name }}')?.value || '—' {{ '}}' }}
                       {{~ end ~}}
                    </span>
                 </div>
             </div>
             {{~ end ~}}
             {{~ end ~}}
             {{~ end ~}}
           </div>
        </div>
        {{~ end ~}}
      </div>

      <!-- Active Interactive Form for Create/Edit Modes -->
      <form *ngIf="mode() !== 'View'" [formGroup]="form" (ngSubmit)="onSubmit()" class="form-mode-panel">
        {{~ for section in sections ~}}
        <div class="section-group">
          <h3 class="section-divider">── {{ section.title }} ──</h3>
          
          <div class="form-grid">
            {{~ for field_name in section.field_names ~}}
            {{~ for f in fields ~}}
            {{~ if f.name == field_name ~}}
            <div class="field-item {{ if f.grid_span == 2 }}col-span-2{{ else if f.grid_span == 1 }}col-span-1{{ else }}{{ f.type == 'string' && f.name | string.downcase | string.contains 'desc' ? 'col-span-2' : 'col-span-1' }}{{ end }}">
              <label for="{{ f.element_id || f.name }}" class="input-label">
                {{ f.label }}
                {{~ if f.is_required ~}}<span class="required-star">*</span>{{~ end ~}}
              </label>

              <!-- Conditional Component Renders based on Type -->
              {{~ if f.type == 'bool' ~}}
              <div class="checkbox-wrapper">
                 <input type="checkbox" id="{{ f.element_id || f.name }}" name="{{ f.element_id || f.name }}" formControlName="{{ f.name }}" 
                        style="{{ f.style }}"
                        class="checkbox-input {{ f.css_class }}" />
                 <span class="checkbox-label">Enable</span>
              </div>
              
              {{~ else if f.type == 'datetime' ~}}
              <input type="date" id="{{ f.element_id || f.name }}" name="{{ f.element_id || f.name }}" formControlName="{{ f.name }}"
                     style="{{ f.style }}"
                     class="input-field {{ f.css_class }}" />
              
              {{~ else if f.type == 'int' || f.type == 'decimal' ~}}
              <input type="number" id="{{ f.element_id || f.name }}" name="{{ f.element_id || f.name }}" formControlName="{{ f.name }}"
                     placeholder="{{ f.placeholder }}"
                     style="{{ f.style }}"
                     class="input-field {{ f.css_class }}" />

              {{~ else if f.type == 'string' && f.name | string.downcase | string.contains 'desc' ~}}
              <textarea id="{{ f.element_id || f.name }}" name="{{ f.element_id || f.name }}" formControlName="{{ f.name }}" rows="4"
                        placeholder="{{ f.placeholder }}"
                        style="{{ f.style }}"
                        class="textarea-field {{ f.css_class }}"></textarea>

              {{~ else ~}}
              <input type="text" id="{{ f.element_id || f.name }}" name="{{ f.element_id || f.name }}" formControlName="{{ f.name }}"
                     placeholder="{{ f.placeholder }}"
                     style="{{ f.style }}"
                     class="input-field {{ f.css_class }}" />
              {{~ end ~}}

              <!-- Inline field error warnings -->
              <div *ngIf="form.get('{{ f.name }}')?.invalid && form.get('{{ f.name }}')?.touched" class="field-error-msg">
                <span>⚠</span> {{ f.label }} is required or formatted incorrectly.
              </div>
            </div>
            {{~ end ~}}
            {{~ end ~}}
            {{~ end ~}}
          </div>
        </div>
        {{~ end ~}}

        <!-- Actions Panel -->
        <div class="actions-panel">
           <button type="button" (click)="onCancel()" class="btn-cancel">
             Cancel
           </button>
           <button type="submit" [disabled]="form.invalid || isSaving()" class="btn-submit">
             <span *ngIf="isSaving()" class="material-icons-outlined spinner-icon">sync</span>
             {{ isSaving() ? 'Saving Stack...' : 'Save Configuration' }}
           </button>
        </div>
      </form>
    </div>
  `,
  styleUrl: './{{ name | string.downcase }}-premium-form.component.css',
  changeDetection: ChangeDetectionStrategy.OnPush
})
export class {{ name }}PremiumFormComponent implements OnInit, OnDestroy {
  @Input() initialData: any = null;
  @Input() initialMode: 'Create' | 'Edit' | 'View' = 'Create';
  
  @Output() save = new EventEmitter<any>();
  @Output() cancel = new EventEmitter<void>();

  // Signals for state binding
  mode = signal<'Create' | 'Edit' | 'View'>('Create');
  isSaving = signal(false);
  error = signal<string | null>(null);

  form: FormGroup;
  private readonly destroyRef = inject(DestroyRef);

  constructor(private readonly fb: FormBuilder, private readonly http: HttpClient) {
    this.form = this.fb.group({
      {{~ for field in fields ~}}
      {{ field.name }}: [
        '{{ field.default_value }}', 
        [
          {{~ if field.is_required ~}}Validators.required,{{~ end ~}}
          {{~ if field.validation_pattern ~}}Validators.pattern(/{{ field.validation_pattern }}/),{{~ end ~}}
        ]
      ],
      {{~ end ~}}
    });
  }

  ngOnInit() {
    this.mode.set(this.initialMode);
    if (this.initialData) {
      this.form.patchValue(this.initialData);
    }
  }

  setMode(newMode: 'Create' | 'Edit' | 'View') {
    this.mode.set(newMode);
  }

  onSubmit() {
    if (this.form.valid) {
      this.isSaving.set(true);
      this.error.set(null);
      
      setTimeout(() => {
        this.isSaving.set(false);
        this.save.emit(this.form.value);
        this.mode.set('View');
      }, 800);
    } else {
      this.form.markAllAsTouched();
      this.error.set('Validation check failed. Please audit highlight fields.');
    }
  }

  onCancel() {
    if (this.form.dirty) {
      const confirmDiscard = confirm('Uncommitted configuration rules exist. Discard changes?');
      if (!confirmDiscard) return;
    }
    this.cancel.emit();
  }

  ngOnDestroy() {}
}
