/* TailAdmin Dashboard Stylesheet */
.dashboard-wrapper {
  margin-left: 280px;
  padding-top: 80px;
  min-height: 100vh;
  background-color: #1A2238;
  color: #AEB7C0;
  font-family: 'Inter', sans-serif;
  transition: margin-left 0.3s;
}

/* Fallback if sidebar is collapsed dynamically */
body.sidebar-collapsed .dashboard-wrapper {
  margin-left: 80px;
}

.main-content {
  padding: 2rem;
  max-width: 1400px;
  margin: 0 auto;
}

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 2rem;
}

.page-title {
  font-size: 1.75rem;
  font-weight: 700;
  color: #fff;
  margin: 0 0 0.25rem;
}

.page-subtitle {
  font-size: 0.75rem;
  color: #8A99AD;
  margin: 0;
  font-family: monospace;
}

.btn-refresh {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  background-color: #3C50E0;
  color: #fff;
  border: none;
  padding: 0.625rem 1.25rem;
  border-radius: 6px;
  font-size: 0.875rem;
  font-weight: 600;
  cursor: pointer;
  transition: background-color 0.2s;
}

.btn-refresh:hover {
  background-color: #2D3EB7;
}

/* Grid Layout */
.dashboard-grid {
  display: grid;
  grid-template-columns: repeat(12, minmax(0, 1fr));
  gap: 1.5rem;
}

.widget-card {
  background-color: #24303F;
  border: 1px solid #2E3A47;
  border-radius: 8px;
  padding: 1.5rem;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
}

.widget-header {
  margin-bottom: 1.25rem;
}

.widget-title-box {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.widget-icon {
  width: 32px;
  height: 32px;
  border-radius: 6px;
  background-color: rgba(60, 80, 224, 0.1);
  color: #3C50E0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.widget-title {
  font-size: 0.875rem;
  font-weight: 700;
  text-transform: uppercase;
  color: #fff;
  margin: 0;
  letter-spacing: 0.05em;
}

.widget-body {
  flex: 1;
}

/* Widget Content Styles */

/* Hero Widget */
.hero-widget {
  text-align: center;
  padding: 2.5rem 1rem;
}

.hero-title {
  font-size: 2rem;
  font-weight: 800;
  color: #fff;
  margin-bottom: 0.75rem;
  letter-spacing: -0.03em;
}

.hero-desc {
  font-size: 0.875rem;
  color: #8A99AD;
  max-width: 480px;
  margin: 0 auto 1.5rem;
}

.hero-btn {
  background-color: #3C50E0;
  color: #fff;
  border: none;
  padding: 0.75rem 1.5rem;
  border-radius: 9999px;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  cursor: pointer;
}

/* Rich Text Widget */
.rich-text-widget {
  font-size: 0.875rem;
  line-height: 1.6;
  color: #AEB7C0;
}

.rich-text-widget p {
  margin-bottom: 1rem;
}

/* Contact Form */
.contact-form-widget {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.form-item {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.form-label {
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  color: #8A99AD;
}

.form-input, .form-textarea {
  background-color: #1A2238;
  border: 1px solid #2E3A47;
  border-radius: 6px;
  padding: 0.5rem 0.75rem;
  color: #fff;
  outline: none;
  font-size: 0.875rem;
}

.form-input:focus, .form-textarea:focus {
  border-color: #3C50E0;
}

.form-btn {
  background-color: #3C50E0;
  color: #fff;
  border: none;
  padding: 0.5rem 1rem;
  border-radius: 6px;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  cursor: pointer;
}

/* Map Widget */
.map-widget {
  height: 200px;
  border-radius: 8px;
  overflow: hidden;
  position: relative;
  border: 1px solid #2E3A47;
  background-color: #1A2238;
}

.map-placeholder {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle, rgba(60,80,224,0.05) 0%, transparent 70%);
}

.map-marker {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -100%);
  font-size: 2.5rem;
  color: #3C50E0;
}

.map-label {
  position: absolute;
  bottom: 12px;
  left: 50%;
  transform: translateX(-50%);
  background-color: rgba(36, 48, 63, 0.9);
  padding: 0.25rem 0.75rem;
  border-radius: 4px;
  font-size: 0.75rem;
  font-weight: 700;
}

/* Stat Widget */
.stat-widget {
  text-align: center;
  padding: 1.5rem 0;
}

.stat-value {
  font-size: 3rem;
  font-weight: 800;
  color: #fff;
  line-height: 1;
  margin-bottom: 0.5rem;
}

.stat-subtitle {
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  color: #8A99AD;
  letter-spacing: 0.1em;
}

/* Grid Widget Table */
.grid-widget {
  overflow-x: auto;
}

.grid-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.8125rem;
  text-align: left;
}

.grid-table th {
  padding: 0.75rem 0.5rem;
  border-bottom: 1px solid #2E3A47;
  color: #fff;
  font-weight: 600;
}

.grid-table td {
  padding: 0.75rem 0.5rem;
  border-bottom: 1px solid rgba(46, 58, 71, 0.5);
  color: #AEB7C0;
}

.badge-status-active {
  background-color: rgba(16, 185, 129, 0.1);
  color: #10B981;
  padding: 0.125rem 0.5rem;
  border-radius: 4px;
  font-size: 0.6875rem;
  font-weight: 700;
}

/* Calendar Widget */
.calendar-widget {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 150px;
  color: #8A99AD;
}

.calendar-icon {
  font-size: 3rem;
  margin-bottom: 0.5rem;
}

.calendar-text {
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

/* Fallback */
.fallback-widget {
  color: #8A99AD;
  font-style: italic;
  font-size: 0.8125rem;
}
