/* TailAdmin Form Component Stylesheet */
:host {
  display: block;
  width: 100%;
}

.form-container-box {
  background-color: #24303F;
  border: 1px solid #2E3A47;
  border-radius: 8px;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  overflow: hidden;
}

.form-header-box {
  padding: 1.25rem 1.5rem;
  border-bottom: 1px solid #2E3A47;
}

.form-title {
  font-size: 1rem;
  font-weight: 700;
  color: #fff;
  margin: 0;
}

.form-body-box {
  padding: 1.5rem;
}

.form-section {
  margin-bottom: 2rem;
}

.section-title {
  font-size: 0.875rem;
  font-weight: 600;
  color: #fff;
  margin-bottom: 1rem;
  border-bottom: 1px solid rgba(46, 58, 71, 0.5);
  padding-bottom: 0.5rem;
}

.fields-grid {
  display: grid;
  gap: 1.25rem;
}

/* Custom Grid helpers */
.grid-cols-2 {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.grid-cols-1 {
  grid-template-columns: repeat(1, minmax(0, 1fr));
}

.col-span-2 {
  grid-column: span 2 / span 2;
}

.form-group-item {
  display: flex;
  flex-direction: column;
  gap: 0.375rem;
}

.field-label {
  font-size: 0.775rem;
  font-weight: 600;
  text-transform: uppercase;
  color: #8A99AD;
  letter-spacing: 0.05em;
}

.required-star {
  color: #F87171;
  margin-left: 0.125rem;
}

.field-input {
  width: 100%;
  background-color: #1A2238;
  border: 1px solid #2E3A47;
  border-radius: 6px;
  padding: 0.625rem 1rem;
  color: #fff;
  outline: none;
  font-size: 0.875rem;
  transition: border-color 0.2s;
  box-sizing: border-box;
}

.field-input:focus {
  border-color: #3C50E0;
}

.field-input.field-error {
  border-color: #F87171;
}

.error-msg-box {
  font-size: 0.75rem;
  color: #F87171;
  font-weight: 500;
  margin-top: 0.25rem;
}

.form-footer-actions {
  display: flex;
  justify-content: flex-end;
  gap: 1rem;
  padding-top: 1.5rem;
  border-top: 1px solid #2E3A47;
  margin-top: 1rem;
}

.btn-primary {
  background-color: #3C50E0;
  color: #fff;
  border: none;
  padding: 0.625rem 1.5rem;
  border-radius: 6px;
  font-size: 0.875rem;
  font-weight: 600;
  cursor: pointer;
  transition: background-color 0.2s;
}

.btn-primary:hover:not(:disabled) {
  background-color: #2D3EB7;
}

.btn-primary:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.btn-secondary {
  background-color: transparent;
  border: 1px solid #2E3A47;
  color: #AEB7C0;
  padding: 0.625rem 1.5rem;
  border-radius: 6px;
  font-size: 0.875rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
}

.btn-secondary:hover {
  background-color: rgba(255, 255, 255, 0.05);
  color: #fff;
}
